APP_ENV=development
DEBUG=True
SECRET_KEY=replace-with-a-long-random-production-secret
ALLOWED_HOSTS=localhost,127.0.0.1,example.com
TIME_ZONE=Asia/Kolkata

POSTGRES_DB=salon_operations
POSTGRES_USER=salon_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

WEB_PORT=8000

# Local HTTP only. Production defaults are enabled when DEBUG=False.
TRUST_PROXY_HEADERS=False

# Receive-only Google review integration. Blank credentials disable these APIs.
# Use independent random tokens (at least 32 characters); never commit real values.
REVIEW_API_TOKEN_SANDBOX=
REVIEW_API_TOKEN_PRODUCTION=
# Set True for any HTTPS deployment, including a publicly reachable test server.
# Local HTTP development may use False. Default: True when DEBUG=False.
# REVIEW_API_REQUIRE_HTTPS=False
