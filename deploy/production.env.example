# Copy OUTSIDE Git, e.g. /etc/salonops/prod.env; chmod 600.
APP_ENV=production
DEBUG=False
SECRET_KEY=replace-with-your-own-random-secret-at-least-50-characters
ALLOWED_HOSTS=operation.hairship.in,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://operation.hairship.in
TIME_ZONE=Asia/Kolkata
TRUST_PROXY_HEADERS=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# Start small. Increase after HTTPS is confirmed; no subdomain/preload opt-in.
SECURE_HSTS_SECONDS=300
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=salon_operations
# App schema owner, NOT the bootstrap superuser below.
POSTGRES_USER=salon_app
POSTGRES_PASSWORD=replace-with-a-separate-random-app-db-password
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-random-bootstrap-password
# Use different names on test and production; never rename an existing volume.
POSTGRES_VOLUME_NAME=salonops-prod-pgdata
WEB_PORT=8000
SALONOPS_IMAGE=ghcr.io/bizla-my-coach/salon-operation@sha256:replace-with-approved-64-hex-digest

# Only used if you choose the optional Caddy configuration.
SITE_DOMAIN=operation.hairship.in
ACME_EMAIL=admin@example.com

# Receive-only review API. Blank keys disable the corresponding environment.
# Store independent random values privately; never commit actual credentials.
REVIEW_INTEGRATION_KEY_SANDBOX=
REVIEW_INTEGRATION_KEY_PRODUCTION=
