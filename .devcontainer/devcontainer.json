{
  "name": "SalonOps dev testing",
  "dockerComposeFile": "compose.yaml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/Salon-Operation",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true,
  "overrideCommand": false,
  "initializeCommand": "bash .devcontainer/initialize.sh",
  "postCreateCommand": "bash .devcontainer/prepare-workspace.sh",
  "shutdownAction": "stopCompose",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "SalonOps test", "onAutoForward": "openBrowser", "protocol": "http"}
  },
  "otherPortsAttributes": {"onAutoForward": "ignore"},
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {"terminal.integrated.defaultProfile.linux": "bash"}
    },
    "codespaces": {"openFiles": ["docs/codespaces.md"]}
  }
}
